# Environment Configuration for Quant Engine
# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Zerodha Mock API ─────────────────────────────────────────────────────────
ZERODHA_API_KEY=mock_api_key_12345
ZERODHA_API_SECRET=mock_secret_12345
ZERODHA_ACCESS_TOKEN=mock_access_token_12345
ZERODHA_BASE_URL=https://api.kite.trade
ZERODHA_WS_URL=wss://ws.kite.trade

# ── Risk Parameters ──────────────────────────────────────────────────────────
MAX_DAILY_LOSS=50000
MAX_EXPOSURE=1000000
MAX_CONSECUTIVE_LOSSES=5
MAX_DRAWDOWN_PCT=10.0
KILL_SWITCH_ENABLED=true

# ── Grid Strategy ────────────────────────────────────────────────────────────
GRID_ATR_MULTIPLIER=1.5
GRID_MAX_POSITIONS=10
GRID_TAKE_PROFIT_MULTIPLIER=2.0
GRID_STOP_LOSS_MULTIPLIER=3.0

# ── Macro Regime ─────────────────────────────────────────────────────────────
MACRO_CSV_PATH=data/macro.csv
VIX_THRESHOLD_HIGH=25.0
VIX_THRESHOLD_EXTREME=35.0

# ── Storage ──────────────────────────────────────────────────────────────────
DUCKDB_PATH=data/quant_engine.duckdb
PARQUET_DIR=data/parquet

# ── Monitoring ───────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=https://hooks.example.com/alerts
ALERT_PHONE_NUMBER=+91XXXXXXXXXX
BLOTTER_EXPORT_PATH=data/blotter.csv

# ── Backtest ─────────────────────────────────────────────────────────────────
BACKTEST_OHLC_PATH=data/sample_ohlc.csv
BACKTEST_SLIPPAGE_PCT=0.05
BACKTEST_BROKERAGE_PCT=0.03
